APP_NAME="Tech Match"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

# Next.js(フロントエンド)のURL。CORS・Sanctum・パスワードリセットのリンク生成で使う
FRONTEND_URL=http://localhost:3000

# Next.jsへの再検証の通知(公開ページのキャッシュの作り直し)。空なら通知しない
# Docker内のLaravelからホストで動くNext.jsへは host.docker.internal で届く
REVALIDATE_URL=http://host.docker.internal:3000/internal/revalidate
# Next.jsのREVALIDATE_SECRETと同じ値(作り方の例: openssl rand -hex 32)
REVALIDATE_SECRET=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ホスト名dbはdocker-compose.ymlのサービス名
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=tech_match
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# 画像の保存先。ローカルはpublicディスク、本番はRailway Bucket(s3)に切り替える
FILESYSTEM_DISK=public
# キューは同期実行(非同期処理が必要になった時点で見直す)
QUEUE_CONNECTION=sync

# Sanctum SPA認証で、Cookieによるセッションを許可するフロントエンドのドメイン
SANCTUM_STATEFUL_DOMAINS=localhost:3000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
